{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deathcharge.github.io/Helix-Unified-Hub/agent-registry.schema.json",
  "title": "Samsarix Agent Registry",
  "description": "Portable metadata and readiness-evidence records for Samsarix Agent Readiness Registry schema v1, including normalized local imports from A2A Agent Cards and MCP Registry server.json metadata.",
  "type": "object",
  "required": ["schemaVersion", "workspace", "agents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workspace": { "$ref": "#/$defs/workspace" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "shortText": { "type": "string", "maxLength": 120 },
    "date": {
      "type": "string",
      "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2}(?:T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z)?)$"
    },
    "workspace": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 600 },
        "updatedAt": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": true
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 160 },
        "contact": { "type": "string", "maxLength": 254 }
      },
      "additionalProperties": true
    },
    "authentication": {
      "type": "object",
      "properties": {
        "schemes": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/namedItem" }
        },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": true
    },
    "interface": {
      "type": "object",
      "required": ["protocol"],
      "properties": {
        "protocol": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "maxLength": 80 },
        "url": { "type": "string", "maxLength": 2048, "pattern": "^(?:$|https://)" }
      },
      "additionalProperties": true
    },
    "namedItem": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 120 },
        {
          "type": "object",
          "anyOf": [{ "required": ["name"] }, { "required": ["id"] }],
          "properties": {
            "name": { "$ref": "#/$defs/shortText" },
            "id": { "$ref": "#/$defs/shortText" }
          },
          "additionalProperties": true
        }
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "classification": {
          "enum": ["unassessed", "public", "internal", "confidential", "restricted"]
        },
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/namedItem" }
        },
        "retention": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "properties": {
        "environment": { "$ref": "#/$defs/shortText" },
        "monitoringOwner": { "type": "string", "maxLength": 160 },
        "incidentContact": { "type": "string", "maxLength": 254 },
        "runbook": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": true
    },
    "evidenceItem": {
      "type": "object",
      "properties": {
        "status": { "enum": ["missing", "declared", "verified"] },
        "reference": { "type": "string", "maxLength": 500 },
        "reviewedAt": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "required": ["reference", "reviewedAt"],
            "properties": {
              "reference": { "minLength": 1 },
              "reviewedAt": { "minLength": 1 }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "purpose": { "$ref": "#/$defs/evidenceItem" },
        "ownership": { "$ref": "#/$defs/evidenceItem" },
        "interface": { "$ref": "#/$defs/evidenceItem" },
        "authentication": { "$ref": "#/$defs/evidenceItem" },
        "data": { "$ref": "#/$defs/evidenceItem" },
        "evaluation": { "$ref": "#/$defs/evidenceItem" },
        "security": { "$ref": "#/$defs/evidenceItem" },
        "oversight": { "$ref": "#/$defs/evidenceItem" },
        "operations": { "$ref": "#/$defs/evidenceItem" }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["id", "name", "summary", "lifecycle", "risk", "owner", "interfaces", "skills", "data", "evidence"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "version": { "type": "string", "maxLength": 80 },
        "lifecycle": {
          "enum": ["concept", "development", "review", "production", "paused", "retired"]
        },
        "risk": { "enum": ["unassessed", "low", "moderate", "high", "critical"] },
        "owner": { "$ref": "#/$defs/owner" },
        "authentication": { "$ref": "#/$defs/authentication" },
        "interfaces": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/interface" }
        },
        "skills": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/namedItem" }
        },
        "data": { "$ref": "#/$defs/data" },
        "deployment": { "$ref": "#/$defs/deployment" },
        "evidence": { "$ref": "#/$defs/evidence" }
      },
      "additionalProperties": true
    }
  }
}
